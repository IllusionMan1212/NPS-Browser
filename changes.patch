+import java.io.File
+
+// TODO: We need to fix the status of pending downloads because if we have 2 downloads in the queue,
+// and they're both paused and we try to resume the 2nd one, it will start downloading the 1st one
+// instead because the flow just emits the first one in the queue. A possible solution would be if
+// the 1st/higher priority download is paused, and we resume the 2nd/low priority one, we should
+// just reorder the 2nd one to the top and resume it.
+// the proper solution is to put whatever download we start/resume at a higher priority than all
+// the paused downloads I think.
+
+// TODO: fix the countless bugs with pausing and resuming downloads
+
+
+// TODO: notifications along with their actions and stuff
+
+// TODO: setting to control how many active downloads there can be
+
+class Downloader(val context: Context, private val downloadManager: DownloadManager) {
+
+    private val store = DownloadStore.getDatabase(context)
+    private val networkHelper = NetworkHelper(context)
+
+    private val _queueState = MutableStateFlow<List<NPSPackageDownload>>(emptyList())
+    val queueState = _queueState.asStateFlow()
+
+    private var downloaderJob: Job? = null
+    private val notifier by lazy { DownloadNotifier(context) }
+
+    private val downloadJobs = mutableMapOf<String, Job>()
+
+    private val scope = CoroutineScope(Dispatchers.IO)
+
+    val isRunning: Boolean
+        get() = downloaderJob?.isActive ?: false
+
+    @Volatile
+    var isPaused: Boolean = false
+
+    init {
+        scope.launch(Dispatchers.IO) {
+            val storeItems = store.downloadDao().getAll().first()
+//            Log.d("DOWNLOAD", "Loaded ${storeItems.size} downloads from database")
+//            Log.d("DOWNLOAD", "Loaded $storeItems from database")
+            addAllToQueue(storeItems)
+        }
+    }
+
+    @OptIn(DelicateCoroutinesApi::class)
+    fun launchIO(block: suspend CoroutineScope.() -> Unit): Job =
+        GlobalScope.launch(Dispatchers.IO, CoroutineStart.DEFAULT, block)
+
+    fun enqueue(download: NPSPackageDownload, autoStart: Boolean) = launchIO {
+        store.downloadDao().insert(download)
+
+        val wasEmpty = queueState.value.isEmpty()
+
+        _queueState.update {
+            download.status = NPSPackageDownload.State.QUEUE
+            it + download
+        }
+
+        if (autoStart && !DownloadService.isRunning(context)) {
+            DownloadService.start(context, downloadManager)
+        }
+    }
+
+    fun start(): Boolean {
+        if (isRunning || queueState.value.isEmpty()) {
+//            Log.d("DOWNLOAD", "Downloader is already running or queue is empty")
+            return false
+        }
+
+        val pending = queueState.value.filter { it.status != NPSPackageDownload.State.DOWNLOADED }
+//        Log.d("DOWNLOAD", "Starting downloader job with ${pending.size} pending downloads")
+//        Log.d("DOWNLOAD", "Pending are $pending")
+        pending.forEach { if (it.status != NPSPackageDownload.State.QUEUE) it.status = NPSPackageDownload.State.QUEUE }
+
+        isPaused = false
+
+        launchDownloaderJob()
+
+        return pending.isNotEmpty()
+    }
+
+    fun pauseAll() {
+        cancelDownloaderJob()
+        queueState.value
+            .filter { it.status == NPSPackageDownload.State.DOWNLOADING || it.status == NPSPackageDownload.State.QUEUE }
+            .forEach { it.status = NPSPackageDownload.State.PAUSED }
+        isPaused = true
+    }
+
+    fun stop(reason: String? = null) {
+        cancelDownloaderJob()
+        queueState.value
+            .filter { it.status == NPSPackageDownload.State.DOWNLOADING }
+            .forEach { it.status = NPSPackageDownload.State.ERROR }
+
+        queueState.value
+            .filter { it.status == NPSPackageDownload.State.QUEUE }
