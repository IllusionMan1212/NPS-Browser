+fun BufferedSource.saveTo(sink: BufferedSink, totalBytes: Long, bytesRead: Long, scope: CoroutineScope): Boolean {
+    val alreadyDownloadedBytes = bytesRead
+    var bytesRead = bytesRead
+    var finishedDownloading = false
+
+    use { input ->
+        try {
+            var noOfBytes = input.read(sink.buffer, DEFAULT_BUFFER_SIZE.toLong())
+            while (noOfBytes != -1L && scope.isActive) {
+                bytesRead += noOfBytes
+//                publishUpdates(channel, bytesRead, totalBytes, DOWNLOADING, uri)
+                noOfBytes = input.read(sink.buffer, DEFAULT_BUFFER_SIZE.toLong())
+            }
+
+            if (bytesRead != totalBytes + alreadyDownloadedBytes) {
+                bytesRead = input.read(sink.buffer, totalBytes - bytesRead)
+            } else {
+                finishedDownloading = true
+            }
+//            publishUpdates(channel, bytesRead, totalBytes, COMPLETED, uri)
+        } catch (e: Exception) {
+            Log.d("DOWNLOAD", "WE HIT AN EXCEPTION: $e")
+        } finally {
+            sink.close()
+            input.close()
+        }
+    }
+
+    return finishedDownloading
+}
